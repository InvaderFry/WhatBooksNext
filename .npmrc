# Don't run dependencies' install scripts. better-sqlite3 ships ready-made binaries for Windows,
# macOS and Linux (prebuilds/*.node) and only ever loads those, but npm adds an automatic
# "node-gyp rebuild" to any package that contains a binding.gyp. That compile needs Visual
# Studio's C++ tools, fails without them, and its output would never be used anyway.
# No other dependency needs an install script. `npm start`, `npm test` and `npm run …`
# still run normally.
ignore-scripts=true
